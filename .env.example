# Copy to .env and fill in the values marked REQUIRED.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Common
# ---------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# Time zone used for "today", "yesterday", "this month" (IANA name)
APP_TIMEZONE=Europe/Moscow

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=expenses
POSTGRES_PASSWORD=expenses
POSTGRES_DB=expenses
# Port published on 127.0.0.1 for local tools (psql, `go run`)
POSTGRES_PORT=5432
# Only for running binaries outside Docker (`go run ./cmd/api`).
# Inside docker compose DATABASE_URL is built from the POSTGRES_* values above.
DATABASE_URL=postgres://expenses:expenses@localhost:5432/expenses?sslmode=disable

# ---------------------------------------------------------------------------
# REST API (web panel)
# ---------------------------------------------------------------------------
HTTP_ADDR=:8080

# ---------------------------------------------------------------------------
# Telegram bot
# ---------------------------------------------------------------------------
# REQUIRED: token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs of family members (the bot ignores others).
# Empty = the bot answers anyone (not recommended). Find your ID via @userinfobot.
ALLOWED_TELEGRAM_IDS=

# ---------------------------------------------------------------------------
# LLM (any OpenAI-compatible Chat Completions API with tool calling)
# ---------------------------------------------------------------------------
# DeepSeek (default):          https://api.deepseek.com       / deepseek-chat
# Local Ollama (profile local-llm): http://ollama:11434/v1    / <model name>
LLM_BASE_URL=https://api.deepseek.com
# REQUIRED: API key (for Ollama any non-empty value, e.g. "ollama")
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60s
LLM_TEMPERATURE=0.1

# ---------------------------------------------------------------------------
# Agent
# ---------------------------------------------------------------------------
# How many previous chat messages the agent sees
AGENT_HISTORY_LIMIT=20
# Max LLM round-trips (tool call -> result -> ...) per user message
AGENT_MAX_STEPS=5
