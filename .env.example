# Copy to .env and fill in the two REQUIRED values:
#   cp .env.example .env
# Everything else has working defaults.

# ===========================================================================
# REQUIRED
# ===========================================================================
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# LLM API key (DeepSeek: https://platform.deepseek.com -> API keys).
# For the local-llm profile any non-empty value, e.g. "ollama".
LLM_API_KEY=

# ===========================================================================
# Family
# ===========================================================================
# Comma-separated Telegram user IDs of family members; the bot refuses others.
# Find your ID via @userinfobot. Empty = the bot answers anyone (not recommended).
ALLOWED_TELEGRAM_IDS=

# ===========================================================================
# LLM (any OpenAI-compatible Chat Completions API with tool calling)
# ===========================================================================
# DeepSeek (default)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Local model instead (docker compose --profile local-llm up -d):
#   LLM_BASE_URL=http://ollama:11434/v1
#   LLM_MODEL=qwen2.5:7b          # must match OLLAMA_MODEL
#   LLM_API_KEY=ollama
LLM_TIMEOUT=60s
LLM_TEMPERATURE=0.1

# Agent: how many previous chat messages the model sees, and the max number
# of LLM round trips (tool call -> result -> ...) per user message
AGENT_HISTORY_LIMIT=20
AGENT_MAX_STEPS=5

# ===========================================================================
# Local LLM (profile local-llm only)
# ===========================================================================
# Open model with tool calling; qwen2.5:7b needs ~5 GB of RAM for Docker
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_IMAGE_TAG=0.40.5

# ===========================================================================
# MCP server (profile mcp only)
# ===========================================================================
# Telegram ID of the family member whose expenses an MCP client works with;
# they must have written to the bot at least once.
MCP_TELEGRAM_ID=

# ===========================================================================
# Common
# ===========================================================================
# debug | info | warn | error
LOG_LEVEL=info
# Time zone of "today", "yesterday", "this month" (IANA name)
APP_TIMEZONE=Europe/Moscow

# ===========================================================================
# Ports and database (defaults are fine for docker compose)
# ===========================================================================
# Web panel: http://localhost:8080
WEB_PORT=8080
# The panel has no login (task requirement): it listens on this machine only.
# 0.0.0.0 opens it to the local network (e.g. to use it from a phone).
WEB_BIND=127.0.0.1
# API on 127.0.0.1 (for the Vite dev server and curl); browsers use the web panel
API_PORT=8081
# Listen address inside the API container (keep :8080 for docker compose)
HTTP_ADDR=:8080

POSTGRES_USER=expenses
POSTGRES_PASSWORD=expenses
POSTGRES_DB=expenses
# Postgres on 127.0.0.1 for psql and `go run`
POSTGRES_PORT=5432
# Only for running binaries outside Docker (`go run ./cmd/api`);
# inside docker compose DATABASE_URL is built from the POSTGRES_* values.
DATABASE_URL=postgres://expenses:expenses@localhost:5432/expenses?sslmode=disable
